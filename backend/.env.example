# Server
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
API_URL=http://localhost:3000

# Auth
JWT_SECRET=change-me-to-a-long-random-string-in-production

# ── PayFast ────────────────────────────────────────────────────────────────────
# Sandbox credentials (already set as defaults in payments.js — only needed in prod)
# Get your live credentials from https://www.payfast.co.za/registration
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=

# ── Email (Nodemailer) ─────────────────────────────────────────────────────────
# Leave blank in dev — emails are printed to the console instead of sent
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=your-app-password
# SendGrid:      SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey  SMTP_PASS=your-sendgrid-api-key
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Collide Sport" <info@collidesport.co.za>
