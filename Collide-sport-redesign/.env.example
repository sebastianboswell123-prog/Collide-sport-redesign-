# ─── PayFast (SERVER-SIDE — set in Vercel, NOT prefixed with VITE_) ────────────
# Signing + ITN verification run in the serverless functions (api/), so these
# must stay server-only. Get them from your PayFast dashboard.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox          # sandbox | live  (sandbox uses PayFast's test merchant)
# PAYFAST_SKIP_IP_CHECK=true  # local/edge debugging only — never in production

# ─── Order store: Upstash Redis (Vercel Marketplace → Redis integration) ──────
# Provisioning the integration injects these automatically; listed for reference.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Base URL used to build PayFast return/cancel/notify URLs.
# Optional on Vercel (falls back to the request host).
SITE_URL=https://collide-sport-redesign.vercel.app

# ─── Frontend flag (optional) ─────────────────────────────────────────────────
# Force the checkout "SANDBOX" badge. Defaults to live in prod builds.
# VITE_PAYFAST_MODE=sandbox

# ─── EmailJS (order confirmation emails) ──────────────────────────────────────
# 1. Sign up at https://www.emailjs.com (free tier: 200 emails/month)
# 2. Create a service connected to info@collidesport.co.za
# 3. Create a template with variables: to_email, to_name, order_id,
#    order_total, order_items, shipping, address
# 4. Paste your IDs below
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key
