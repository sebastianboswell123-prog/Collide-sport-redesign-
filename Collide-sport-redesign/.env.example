# ── Collide Sport — environment variables ────────────────────────────────────
# Copy to `.env` for local dev, or set in Vercel → Settings → Environment Variables.
# Only VITE_-prefixed vars are exposed to the client bundle.

# ── PayFast ───────────────────────────────────────────────────────────────────
# Mode is auto-selected: sandbox in dev (npm run dev), live in production builds.
# Override here if needed: 'sandbox' | 'live'
# VITE_PAYFAST_MODE=sandbox

# Live merchant credentials (required for production — get these from your
# PayFast dashboard). Sandbox uses PayFast's public test merchant automatically.
VITE_PAYFAST_MERCHANT_ID=
VITE_PAYFAST_MERCHANT_KEY=

# Server endpoint that receives PayFast's ITN (payment notification) callback.
# Must verify the signature + confirm the order server-side before fulfilment.
# Defaults to <origin>/api/payfast-itn if unset.
VITE_PAYFAST_NOTIFY_URL=

# ── Formspree (order confirmation + contact emails) ───────────────────────────
# The form ID from https://formspree.io (the bit after /f/). Without it,
# confirmation emails are skipped gracefully.
VITE_FORMSPREE_ID=
