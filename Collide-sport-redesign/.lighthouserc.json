{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:5173/",
        "http://localhost:5173/catalogue",
        "http://localhost:5173/about"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-gpu --disable-dev-shm-usage --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding"
      }
    },

    "assert": {
      "assertions": {
        "categories:performance":      ["error", { "minScore": 0.90 }],
        "categories:seo":              ["error", { "minScore": 0.90 }],
        "categories:accessibility":    ["error", { "minScore": 0.90 }],
        "categories:best-practices":   ["warn",  { "minScore": 0.90 }],

        "cumulative-layout-shift":     ["error", { "maxNumericValue": 0.1 }],

        "meta-description":            ["error", { "maxLength": 0 }],
        "document-title":              ["error", { "maxLength": 0 }],
        "viewport":                    ["error", { "maxLength": 0 }],
        "image-alt":                   ["error", { "maxLength": 0 }],
        "heading-order":               ["warn",  { "maxLength": 0 }]
      }
    },

    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
